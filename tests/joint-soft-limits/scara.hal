loadrt [KINS]KINEMATICS
setp scarakins.D1 0
setp scarakins.D2 10
setp scarakins.D3 0
setp scarakins.D4 10
setp scarakins.D5 0
setp scarakins.D6 0
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
addf motion-command-handler servo-thread
addf motion-controller servo-thread

net joint0 joint.0.motor-pos-cmd => joint.0.motor-pos-fb
net joint1 joint.1.motor-pos-cmd => joint.1.motor-pos-fb
net joint2 joint.2.motor-pos-cmd => joint.2.motor-pos-fb
net joint3 joint.3.motor-pos-cmd => joint.3.motor-pos-fb
net joint4 joint.4.motor-pos-cmd => joint.4.motor-pos-fb
net joint5 joint.5.motor-pos-cmd => joint.5.motor-pos-fb
net estop iocontrol.0.user-enable-out => iocontrol.0.emc-enable-in
